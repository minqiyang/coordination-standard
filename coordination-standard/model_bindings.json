{
  "bindings_version": "0.13.0",
  "status": "LIVE_MODEL_BINDINGS",
  "access_plans": {
    "chatgpt_plus": {
      "display_name": "ChatGPT Plus",
      "subscribed": true
    },
    "claude_subscription": {
      "display_name": "Claude subscription",
      "subscribed": true
    }
  },
  "model_aliases": {
    "GPT_ASTRA_LATEST": {
      "family": "GPT Astra",
      "selector": "latest",
      "access_plan_ref": "chatgpt_plus"
    },
    "OPUS_LATEST": {
      "family": "Opus",
      "selector": "latest",
      "access_plan_ref": "claude_subscription"
    }
  },
  "harnesses": {
    "Claude Code": {
      "herdr_kind": "claude",
      "effort_arg": [
        "--effort",
        "{effort}"
      ],
      "effort_overrides": {
        "ultracode": [
          "--effort",
          "xhigh",
          "--settings",
          "{\"ultracode\":true}"
        ]
      }
    },
    "Codex": {
      "herdr_kind": "codex",
      "effort_arg": [
        "-c",
        "model_reasoning_effort=\"{effort}\""
      ]
    }
  },
  "route_bindings": {
    "GENERAL_EXEC": {
      "model_ref": "OPUS_LATEST",
      "harness": "Claude Code",
      "default_effort": "high"
    },
    "REVIEW": {
      "model_ref": "GPT_ASTRA_LATEST",
      "harness": "Codex",
      "default_effort": "high",
      "replacement": {
        "model_ref": "OPUS_LATEST",
        "harness": "Claude Code",
        "default_effort": "medium"
      }
    },
    "AUDIT": {
      "model_ref": "GPT_ASTRA_LATEST",
      "harness": "Codex",
      "default_effort": "high",
      "replacement": {
        "model_ref": "OPUS_LATEST",
        "harness": "Claude Code",
        "default_effort": "medium"
      }
    },
    "AUDIT_2": {
      "model_ref": "OPUS_LATEST",
      "harness": "Claude Code",
      "default_effort": "high"
    },
    "DESIGN": {
      "model_ref": "OPUS_LATEST",
      "harness": "Claude Code",
      "default_effort": "high"
    },
    "EXPERT": {
      "model_ref": "OPUS_LATEST",
      "harness": "Claude Code",
      "default_effort": "ultracode"
    },
    "FRONTEND": {
      "model_ref": "OPUS_LATEST",
      "harness": "Claude Code",
      "default_effort": "high"
    }
  },
  "session_reuse": {
    "max_context_tokens": 200000,
    "max_idle_minutes": 55
  }
}
