{
  "table_version": "0.13.0",
  "status": "LIVE_ROUTING_TABLE",
  "child_session_defaults": {
    "permission_mode": "always_approve"
  },
  "review_seats": {
    "ROUTINE": [],
    "ELEVATED": [
      "REVIEW"
    ],
    "CRITICAL": [
      "AUDIT",
      "AUDIT_2"
    ]
  },
  "pr_merge_minimum_gate": {
    "minimum_lane": "ELEVATED"
  },
  "routes": {
    "COORD": {
      "capability": "control-namespace coordination and deterministic verification",
      "capability_class": "coordination",
      "default": true,
      "may_author_plan": false,
      "may_formally_review": false
    },
    "GENERAL_EXEC": {
      "capability": "ordinary implementation, debugging, integration, interaction logic, and repair of its own candidates",
      "capability_class": "implementation",
      "default": true,
      "may_author_plan": false,
      "may_formally_review": false,
      "prompt_constraints": [
        "scope_clamp"
      ]
    },
    "REVIEW": {
      "capability": "formal review seat for ELEVATED candidates",
      "capability_class": "review",
      "default": true,
      "may_author_plan": false,
      "may_formally_review": true
    },
    "DESIGN": {
      "capability": "required architecture or interface decisions and binding-plan authorship; excludes ordinary implementation planning, local code adjustments, and bug-cause analysis",
      "capability_class": "design",
      "default": false,
      "may_author_plan": true,
      "may_formally_review": false,
      "dispatch_triggers": [
        {
          "trigger_id": "DESIGN_BINDING_PLAN_AUTHOR",
          "when": "card_requires_binding_plan_authorship"
        },
        {
          "trigger_id": "DESIGN_ARCHITECTURE_DECISION",
          "when": "required_deliverable_is_a_formal_architecture_or_interface_decision_not_ordinary_implementation_planning_local_code_adjustment_or_bug_cause_analysis"
        }
      ],
      "prompt_constraints": [
        "scope_clamp"
      ]
    },
    "EXPERT": {
      "capability": "final problem-solving escalation for unresolved design, architecture, planning, analysis, or implementation",
      "capability_class": "problem_solving",
      "default": false,
      "may_author_plan": true,
      "may_formally_review": false,
      "dispatch_triggers": [
        {
          "trigger_id": "USER_REQUESTED_EXPERT",
          "when": "user_explicitly_requests_expert_escalation_for_this_task"
        },
        {
          "trigger_id": "EXPERT_REPAIR_CONTINUATION",
          "when": "expert_attempt_fails_within_three_post_escalation_failed_attempts_and_same_previously_escalated_core_problem_remains_or_evidence_shows_repairs_are_worsening_it_and_coordinator_records_expert_continuation"
        },
        {
          "trigger_id": "FAILURE_LIMIT",
          "when": "card_has_three_failed_ordinary_attempts_from_qa_failure_material_verification_or_review_findings_or_no_candidate_excluding_operational_failures_and_unclear_requirements"
        }
      ],
      "prompt_constraints": [
        "scope_clamp"
      ]
    },
    "FRONTEND": {
      "capability": "aesthetic, visual, and art-direction design only",
      "capability_class": "implementation",
      "default": false,
      "may_author_plan": false,
      "may_formally_review": false,
      "dispatch_triggers": [
        {
          "trigger_id": "FRONTEND_DESIGN_SYSTEM",
          "when": "card_output_is_design_system_tokens_or_visual_language"
        },
        {
          "trigger_id": "FRONTEND_HIGH_FIDELITY",
          "when": "card_output_is_high_fidelity_visual_composition"
        },
        {
          "trigger_id": "FRONTEND_ART_DIRECTION",
          "when": "card_output_is_art_direction_or_aesthetic_authority"
        }
      ],
      "prompt_constraints": [
        "scope_clamp"
      ],
      "hard_constraints": [
        "no_implementation_or_interaction_logic",
        "no_review_or_audit_seat",
        "no_plan_authorship"
      ]
    },
    "AUDIT": {
      "capability": "first formal review seat for CRITICAL candidates, including structural work and binding plans, with deep failure audit",
      "capability_class": "review",
      "default": true,
      "may_author_plan": false,
      "may_formally_review": true
    },
    "AUDIT_2": {
      "capability": "second formal review seat for CRITICAL candidates, including structural work and binding plans",
      "capability_class": "review",
      "default": true,
      "may_author_plan": false,
      "may_formally_review": true
    }
  },
  "scope_clamp": "Stay strictly within this card's objective, authority, read scope, and write scope. If additional work is required, state the missing scope in one line and stop. Do not perform that additional work."
}
