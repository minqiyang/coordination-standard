{
  "bindings_version": "0.8.1",
  "updated": "2026-10-08",
  "note": "Only file to edit when models change; rules live in coordinator.md. Placeholders: {id} {effort} {attempt_dir} (absolute <coord>/<task>/<agent>/, the launched session's own folder; all its attempts write inside it). Recheck flags with `claude --help` / `codex --help` after CLI updates.",
  "harnesses": {
    "claude": {
      "model_arg": ["--model", "{id}"],
      "effort_arg": ["--effort", "{effort}"],
      "effort_overrides": {
        "ultracode": ["--effort", "xhigh", "--settings", "{\"ultracode\":true}"]
      },
      "permission_args": ["--permission-mode", "auto", "--add-dir", "{attempt_dir}"]
    },
    "codex": {
      "model_arg": ["-m", "{id}"],
      "effort_arg": ["-c", "model_reasoning_effort=\"{effort}\""],
      "permission_args": ["-a", "never", "-s", "workspace-write", "--add-dir", "{attempt_dir}"]
    }
  },
  "models": {
    "opus": { "harness": "claude", "id": "opus" },
    "sonnet": { "harness": "claude", "id": "sonnet" },
    "haiku": { "harness": "claude", "id": "haiku" },
    "fable": { "harness": "claude", "id": "fable" },
    "gpt": { "harness": "codex", "id": "gpt-6.1-sol" }
  },
  "adjustments": { "harnesses": ["claude"], "min_effort": "medium", "max_effort": "xhigh" },
  "routes": {
    "GENERAL_EXEC": { "model": "opus", "effort": "high" },
    "EXPERT": { "model": "opus", "effort": "ultracode" },
    "REVIEW": { "model": "gpt", "effort": "xhigh", "replacement": { "model": "opus", "effort": "xhigh" } },
    "AUDIT": { "model": "gpt", "effort": "xhigh", "replacement": { "model": "opus", "effort": "xhigh" } },
    "AUDIT_2": { "model": "opus", "effort": "xhigh" },
    "ADJUDICATOR": { "model": "opus", "effort": "xhigh" }
  }
}
